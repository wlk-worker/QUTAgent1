#!/usr/bin/env python3
"""Bounded Web baseline recon helper (PentestGPT-style inventory).

Usage:
    ctf-web-recon <http(s)-url> [--timeout 8] [--max-pages 6] [--json]

Fetches the seed page plus robots.txt/sitemap.xml, then extracts links, forms,
scripts and parameters. It never submits a form, never follows off-origin links
and never writes files. Output is a compact JSON object so the model can keep
the facts instead of re-fetching the same page.

This is guidance/tooling only: the model still decides which confirmed bug class
to exploit against the authorized target.
"""
from __future__ import annotations

import argparse
import json
import re
import ssl
import sys
import urllib.error
import urllib.parse
import urllib.request
from html.parser import HTMLParser

MAX_BYTES = 250_000
MAX_ITEMS = 60
MAX_CHARS = 18_000


class _Parser(HTMLParser):
    def __init__(self) -> None:
        super().__init__(convert_charrefs=True)
        self.links: list[str] = []
        self.scripts: list[str] = []
        self.forms: list[dict] = []
        self._form: dict | None = None
        self.title = ""
        self._in_title = False

    def handle_starttag(self, tag: str, attrs) -> None:
        values = {str(k).lower(): (v or "") for k, v in attrs}
        tag = tag.lower()
        if tag == "a" and values.get("href"):
            self.links.append(values["href"])
        elif tag == "script" and values.get("src"):
            self.scripts.append(values["src"])
        elif tag == "form":
            self._form = {
                "method": (values.get("method") or "GET").upper(),
                "action": values.get("action") or "",
                "inputs": [],
            }
            self.forms.append(self._form)
        elif tag in {"input", "textarea", "select", "button"} and self._form is not None:
            name = values.get("name") or ""
            if name:
                self._form["inputs"].append({
                    "name": name,
                    "type": values.get("type") or tag,
                    "value": values.get("value") or "",
                })
        elif tag == "title":
            self._in_title = True

    def handle_endtag(self, tag: str) -> None:
        if tag.lower() == "title":
            self._in_title = False
        elif tag.lower() == "form":
            self._form = None

    def handle_data(self, data: str) -> None:
        if self._in_title:
            self.title += data


def _bounded(text: str, limit: int = MAX_CHARS) -> tuple[str, bool]:
    text = str(text or "")
    return (text, False) if len(text) <= limit else (text[:limit] + "\n...[truncated]", True)


def _fetch(url: str, timeout: float) -> tuple[int | None, str, str, str]:
    context = ssl.create_default_context()
    context.check_hostname = False
    context.verify_mode = ssl.CERT_NONE
    request = urllib.request.Request(url, headers={
        "User-Agent": "qutagent-web-recon/1.0",
        "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
    })
    try:
        with urllib.request.urlopen(request, timeout=timeout, context=context) as response:
            raw = response.read(MAX_BYTES)
            charset = response.headers.get_content_charset() or "utf-8"
            return response.status, raw.decode(charset, errors="replace"), response.geturl(), ""
    except urllib.error.HTTPError as exc:
        raw = exc.read(MAX_BYTES)
        return exc.code, raw.decode("utf-8", errors="replace"), url, ""
    except Exception as exc:  # noqa: BLE001 - report, never crash the model turn
        return None, "", url, type(exc).__name__ + ": " + str(exc)[:200]


def _origin(url: str) -> tuple[str, str, int]:
    parsed = urllib.parse.urlsplit(url)
    scheme = parsed.scheme.lower()
    host = (parsed.hostname or "").lower()
    port = parsed.port or (443 if scheme == "https" else 80)
    return scheme, host, port


def _same_origin(base: str, other: str) -> bool:
    return _origin(base) == _origin(other)


def _normalize(base: str, value: str) -> str:
    try:
        return urllib.parse.urljoin(base, value.strip())
    except ValueError:
        return ""


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="Bounded Web baseline recon")
    parser.add_argument("url")
    parser.add_argument("--timeout", type=float, default=8.0)
    parser.add_argument("--max-pages", type=int, default=6)
    parser.add_argument("--json", action="store_true", help="JSON output (default)")
    args = parser.parse_args(argv)
    timeout = max(1.0, min(float(args.timeout), 20.0))
    max_pages = max(1, min(int(args.max_pages), 20))

    parsed = urllib.parse.urlsplit(args.url)
    if parsed.scheme not in {"http", "https"} or not parsed.netloc:
        print(json.dumps({"error": "only http(s) URLs are allowed"}))
        return 2
    base = f"{parsed.scheme}://{parsed.netloc}{parsed.path or '/'}"
    origin = f"{parsed.scheme}://{parsed.netloc}"

    pages: list[dict] = []
    seen: set[str] = set()
    queue = [args.url]
    links: list[str] = []
    scripts: list[str] = []
    forms: list[dict] = []
    parameters: set[str] = set()
    errors: list[dict] = []
    title = ""

    while queue and len(pages) < max_pages:
        url = queue.pop(0)
        if url in seen or not _same_origin(origin + "/", url):
            continue
        seen.add(url)
        status, body, final_url, error = _fetch(url, timeout)
        if error:
            errors.append({"url": url, "error": error})
            continue
        page_parser = _Parser()
        try:
            page_parser.feed(body)
        except Exception:  # noqa: BLE001 - malformed HTML is still useful as text
            pass
        if not title and page_parser.title:
            title = re.sub(r"\s+", " ", page_parser.title).strip()[:200]
        preview, _ = _bounded(re.sub(r"\s+", " ", body), 1200)
        pages.append({"url": final_url or url, "status": status,
                      "title": page_parser.title[:200], "preview": preview})
        for raw in page_parser.links + page_parser.scripts:
            absolute = _normalize(final_url or url, raw)
            if not absolute or not _same_origin(origin + "/", absolute):
                continue
            if raw in page_parser.scripts:
                if absolute not in scripts:
                    scripts.append(absolute)
            elif absolute not in links:
                links.append(absolute)
            parsed_link = urllib.parse.urlsplit(absolute)
            for key in urllib.parse.parse_qs(parsed_link.query):
                parameters.add(key)
            if len(links) + len(scripts) < MAX_ITEMS and absolute not in seen:
                queue.append(absolute)
        forms.extend(page_parser.forms)

    for path in ("/robots.txt", "/sitemap.xml"):
        status, body, final_url, error = _fetch(origin + path, timeout)
        if error:
            errors.append({"url": origin + path, "error": error})
        elif status == 200:
            text, truncated = _bounded(body, 4000)
            pages.append({"url": final_url or origin + path, "status": status,
                          "kind": path.lstrip("/"), "body": text,
                          "truncated": truncated})

    result = {
        "seed": args.url,
        "origin": origin,
        "title": title,
        "pages": pages[:max_pages + 2],
        "links": links[:MAX_ITEMS],
        "scripts": scripts[:MAX_ITEMS],
        "forms": forms[:MAX_ITEMS],
        "parameters": sorted(parameters)[:MAX_ITEMS],
        "errors": errors[:20],
        "note": "GET-only baseline; no forms submitted and no off-origin request made.",
    }
    encoded = json.dumps(result, ensure_ascii=False, indent=2)
    print(encoded[:MAX_CHARS])
    if len(encoded) > MAX_CHARS:
        print("\n...[ctf-web-recon truncated]", file=sys.stderr)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
