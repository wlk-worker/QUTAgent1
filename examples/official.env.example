# Copy to artifacts/official.env and fill in values. Never commit the real token.
CTFY_PLATFORM_URL=https://ctfy.tsinghua.edu.cn
CTFY_TOKEN=pf_REPLACE_WITH_AGENT_PLAY_TOKEN
CTFY_COMPETITION_ID=c0d8b4e3dd3b42c095d63d7dfa66431f

# Official model gateway session: use OPENAI_BASE_URL / OPENAI_API_KEY
# (or ANTHROPIC_*) from the platform's "本地 Agent 会话" page.  Only set
# LLM_BASE_URL / LLM_API_KEY for a non-gateway practice run.
LLM_FLAVOR=openai
LLM_MODEL=REPLACE_WITH_MODEL_ID

# Optional WireGuard auto-connect (requires wg-quick and permissions):
# QUT_WG_UP=1
